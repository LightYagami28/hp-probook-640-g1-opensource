chip northbridge/intel/haswell
	register "ec_present" = "true"
	register "gfx" = "GMA_STATIC_DISPLAYS(0)"
	register "gpu_ddi_e_connected" = "1"
	register "gpu_dp_b_hotplug" = "4"
	register "gpu_dp_c_hotplug" = "4"
	register "gpu_dp_d_hotplug" = "4"
	register "panel_cfg" = "{
		.up_delay_ms		= 200,
		.down_delay_ms		=  50,
		.cycle_delay_ms		= 500,
		.backlight_on_delay_ms	=   1,
		.backlight_off_delay_ms	=   1,
		.backlight_pwm_hz	= 200,
	}"
	register "spd_addresses" = "{0x50, 0, 0x52, 0}"
	register "usb_xhci_on_resume" = "true"
	chip cpu/intel/haswell
		device cpu_cluster 0x0 on
			ops haswell_cpu_bus_ops
		end
	end
	device domain 0x0 on
		ops haswell_pci_domain_ops
		device pci 00.0 on # Mobile Host bridge
			subsystemid 0x103c 0x1993
		end
		device pci 01.0 off # PCIe Bridge for discrete graphics
		end
		device pci 02.0 on # Internal graphics VGA controller
			subsystemid 0x103c 0x1993
		end
		device pci 03.0 on # Mini-HD audio
			subsystemid 0x103c 0x1993
		end
		chip southbridge/intel/lynxpoint # Intel 8 Series Lynx Point PCH
			register "docking_supported" = "1"
			register "gen1_dec" = "LPC_IO(0x200, 0x80)"
			register "gen2_dec" = "LPC_IO(0x100, 0x10)"
			register "gen4_dec" = "LPC_IO(0x2e8, 0x8)"
			register "gpe0_en_1" = "0x20480046"
			register "gpe0_en_2" = "0x0"
			register "gpi6_routing" = "2"
			register "sata_port0_gen3_dtle" = "0x0"
			register "sata_port1_gen3_dtle" = "0x0"
			register "sata_port_map" = "0x37"
			device pci 14.0 on # xHCI Controller
				subsystemid 0x103c 0x1993
			end
			device pci 16.0 on # Management Engine Interface 1
				subsystemid 0x103c 0x1993
			end
			device pci 16.1 off # Management Engine Interface 2
			end
			device pci 16.2 off # Management Engine IDE-R
			end
			device pci 16.3 off # Management Engine KT
			end
			device pci 19.0 on # Intel Gigabit Ethernet (I217-LM)
				subsystemid 0x103c 0x1993
			end
			device pci 1a.0 on # USB2 EHCI #2
				subsystemid 0x103c 0x1993
			end
			device pci 1b.0 on # High Definition Audio
				subsystemid 0x103c 0x1993
			end
			device pci 1c.0 on # PCIe Port #1
				subsystemid 0x103c 0x1993
			end
			device pci 1c.1 off # PCIe Port #2
			end
			device pci 1c.2 off # PCIe Port #3
			end
			device pci 1c.3 off # PCIe Port #4
			end
			device pci 1c.4 off # PCIe Port #5
			end
			device pci 1c.5 off # PCIe Port #6
			end
			device pci 1c.6 on # PCIe Port #7 (Realtek RTS5227 SD Card Reader)
				subsystemid 0x103c 0x1993
			end
			device pci 1c.7 on # PCIe Port #8 (Broadcom BCM43228 Wi-Fi)
				subsystemid 0x103c 0x1993
			end
			device pci 1d.0 on # USB2 EHCI #1
				subsystemid 0x103c 0x1993
			end
			device pci 1f.0 on # LPC bridge
				subsystemid 0x103c 0x1993
				chip ec/hp/kbc1126
					register "ec_data_port" = "0x62"
					register "ec_cmd_port"  = "0x66"
					register "ec_ctrl_reg"  = "0x81"
					register "ec_fan_ctrl_value" = "0x6b"
					device pnp ff.1 off end
				end
			end
			device pci 1f.2 on # SATA Controller (AHCI)
				subsystemid 0x103c 0x1993
			end
			device pci 1f.3 on # SMBus
				subsystemid 0x103c 0x1993
			end
			device pci 1f.5 off # SATA Controller (Legacy)
			end
			device pci 1f.6 off # Thermal
			end
		end
	end
end
